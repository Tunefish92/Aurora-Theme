Menu="Buttons"
Link="nav-user"
Title="Aurora Theme"
---
<?php
// Unraid evaluates every "Buttons" page inside <head> on each page, after its own stylesheets,
// so this is where the theme's files are attached. Link="nav-user" keeps it from adding a button.
$aurora = parse_plugin_cfg('Aurora-Theme');
$auroraCustomDir = '/boot/config/plugins/Aurora-Theme';
$auroraClasses = [];
if (($aurora['layout'] ?? 'top') == 'sidebar') $auroraClasses[] = 'tp-sidebar';
if (($aurora['enhance'] ?? 'yes') == 'yes') $auroraClasses[] = 'tp-enhance';
// Display Settings, "Favorites enabled" set to No also turns off the theme's starred cards.
if (($display['favorites'] ?? 'yes') == 'no') $auroraClasses[] = 'tp-no-favourites';

// Emergency switch: opening any page with ?aurora=off stops the plugin from loading anything
// in this browser (remembered in a cookie) until a page is opened with ?aurora=on.
$auroraSwitch = $_GET['aurora'] ?? '';
$auroraOff = $auroraSwitch == 'off' || ($auroraSwitch != 'on' && !empty($_COOKIE['aurora_off']));
// The theme is made for Unraid's top-navigation themes (Black, White). Azure and Gray have
// their own sidebar layout, so there the plugin loads nothing and leaves them as they are.
if (isset($themeHelper) && method_exists($themeHelper, 'isTopNavTheme') && !$themeHelper->isTopNavTheme()) $auroraOff = true;
?>
<?php if ($auroraSwitch == 'off'): ?>
<script>document.cookie = 'aurora_off=1; path=/; max-age=31536000; SameSite=Lax';</script>
<?php elseif ($auroraSwitch == 'on'): ?>
<script>document.cookie = 'aurora_off=; path=/; max-age=0; SameSite=Lax';</script>
<?php endif; ?>
<?php if (!$auroraOff): ?>
<?php if (($aurora['theme'] ?? 'yes') == 'yes'): ?>
<link type="text/css" rel="stylesheet" href="<?php autov('/plugins/Aurora-Theme/styles/theme.css') ?>">
<?php
// Display Settings, header custom text, secondary text and background colours: the theme sets
// Unraid's header variables itself, so the chosen colours are handed to it under its own names.
$auroraHeaderVars = [];
foreach (['header' => '--tp-custom-header-text', 'headermetacolor' => '--tp-custom-header-muted', 'background' => '--tp-custom-header-bg'] as $auroraKey => $auroraVar) {
    $auroraHex = (string) ($display[$auroraKey] ?? '');
    if (preg_match('/^([0-9a-fA-F]{3}){1,2}$/', $auroraHex)) $auroraHeaderVars[] = "$auroraVar: #$auroraHex;";
}
?>
<?php if ($auroraHeaderVars): ?>
<style id="aurora-header-colors">:root { <?= implode(' ', $auroraHeaderVars) ?> }</style>
<?php endif; ?>
<?php
// Accent colour from the plugin's settings ("#e11d48"; empty keeps the theme's blue). The
// theme's shades are mixed from it, and the text on accent buttons is white or near-black,
// whichever stands out more.
$auroraAccent = strtolower(ltrim(trim((string) ($aurora['accent'] ?? '')), '#'));
if (preg_match('/^[0-9a-f]{3}$/', $auroraAccent)) $auroraAccent = preg_replace('/(.)/', '$1$1', $auroraAccent);
if (preg_match('/^[0-9a-f]{6}$/', $auroraAccent)):
    $auroraLum = function ($hex) {
        $l = [];
        foreach (str_split($hex, 2) as $c) { $v = hexdec($c) / 255; $l[] = $v <= 0.03928 ? $v / 12.92 : (($v + 0.055) / 1.055) ** 2.4; }
        return 0.2126 * $l[0] + 0.7152 * $l[1] + 0.0722 * $l[2];
    };
    $auroraL = $auroraLum($auroraAccent);
    $auroraOnAccent = (1.05 / ($auroraL + 0.05)) >= (($auroraL + 0.05) / ($auroraLum('06101f') + 0.05)) ? '#ffffff' : '#06101f';
    $auroraHex = "#$auroraAccent";
    $auroraScale = [];
    foreach ([50 => 'white 92%', 100 => 'white 84%', 200 => 'white 68%', 300 => 'white 48%', 400 => 'white 24%', 500 => 'white 6%', 600 => 'black 8%', 700 => 'black 24%', 800 => 'black 40%', 900 => 'black 54%', 950 => 'black 70%'] as $auroraStep => $auroraMix) {
        $auroraScale[] = "--color-primary-$auroraStep: color-mix(in oklab, $auroraHex, $auroraMix); --ui-color-primary-$auroraStep: color-mix(in oklab, $auroraHex, $auroraMix);";
    }
?>
<style id="aurora-accent">
:root:root:root { --tp-primary: <?= $auroraHex ?>; --tp-primary-ii: color-mix(in oklab, <?= $auroraHex ?> 62%, white); --tp-primary-soft: color-mix(in srgb, <?= $auroraHex ?> 15%, transparent); --tp-primary-text: <?= $auroraOnAccent ?>; }
.unapi:not(#tp-none):not(#tp-none) { <?= implode(' ', $auroraScale) ?> }
</style>
<?php endif; ?>
<script>
// Theme credit at the end of the footer.
document.addEventListener('DOMContentLoaded', function () {
  var footer = document.getElementById('copyright');
  if (!footer || footer.querySelector('.tp-credit')) return;
  var link = document.createElement('a');
  link.className = 'tp-credit';
  link.href = 'https://github.com/Tunefish92';
  link.target = '_blank';
  link.rel = 'noopener noreferrer';
  link.title = 'Aurora Theme on GitHub';
  link.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/></svg>Aurora Theme by <strong>Tunefish</strong>';
  footer.append(link);
});
</script>
<?php endif; ?>
<script>
// "tp-topbar" while the menu is a bar across the top: always in the top layout, and in the
// sidebar layout on screens narrower than 1024px. Set here in the head, so there is no flash.
(function (root, sidebar) {
  var wide = window.matchMedia('(min-width: 1024px)');
  var set = function () { root.classList.toggle('tp-topbar', !(sidebar && wide.matches)); };
  set();
  wide.addEventListener('change', set);
})(document.documentElement, <?= in_array('tp-sidebar', $auroraClasses) ? 'true' : 'false' ?>);
</script>
<?php if (in_array('tp-sidebar', $auroraClasses)): ?>
<link type="text/css" rel="stylesheet" href="<?php autov('/plugins/Aurora-Theme/styles/layout-sidebar.css') ?>">
<?php endif; ?>
<?php if (in_array('tp-enhance', $auroraClasses)): ?>
<?php
// The page's own title ("CPU Pinning", "UPS Settings") for the heading and breadcrumb, made the
// way Unraid makes its section titles. Without it the script names the page from its address.
$auroraTitle = '';
try {
    $auroraTitle = (string) ($myPage['Title'] ?? '');
    if ($auroraTitle !== '' && function_exists('processTitle')) $auroraTitle = processTitle($auroraTitle);
    if ($auroraTitle !== '' && function_exists('parse_text')) $auroraTitle = _(parse_text(html_entity_decode($auroraTitle)));
    $auroraTitle = trim(preg_replace('/\s+/', ' ', strip_tags($auroraTitle)));
    if (strpos($auroraTitle, '$') !== false || mb_strlen($auroraTitle) > 60) $auroraTitle = '';
} catch (Throwable $auroraError) {
    $auroraTitle = '';
}
?>
<?php if ($auroraTitle !== ''): ?>
<script>window.auroraPageTitle = <?= json_encode($auroraTitle, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;</script>
<?php endif; ?>
<link type="text/css" rel="stylesheet" href="<?php autov('/plugins/Aurora-Theme/styles/enhance.css') ?>">
<script defer src="<?php autov('/plugins/Aurora-Theme/scripts/enhance.js') ?>"></script>
<?php
// Docker tab and Dashboard: the saved application groups go straight into the page, so the
// containers can be shown grouped right away instead of waiting for a separate request.
if (in_array(rtrim((string) parse_url($_SERVER['REQUEST_URI'] ?? '', PHP_URL_PATH), '/'), ['/Docker', '/Dashboard'], true)):
    $auroraGroups = json_decode((string) @file_get_contents("$auroraCustomDir/docker-groups.json"), true);
    $auroraGroups = is_array($auroraGroups['groups'] ?? null) ? $auroraGroups['groups'] : [];
?>
<script>window.auroraDockerGroups = <?= json_encode($auroraGroups, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;</script>
<script>window.auroraDecimalMark = <?= json_encode(substr((string) ($display['number'] ?? '.,'), 0, 1) ?: '.') ?>;</script>
<?php
    // FolderView installed: the switch above the Docker list chooses between its folders and the
    // theme's view (columns, groups). For the theme's view, FolderView's takeover of Unraid's
    // listview() and loadlist() is undone: it keeps the originals as listview_original and
    // loadlist_original, and as soon as it does, they are put back (after its script has run,
    // before Unraid draws the list). FolderView's own "hide the list until the folders are
    // built" is lifted at once.
    $auroraFolderView = is_dir('/usr/local/emhttp/plugins/folder.view3') || is_dir('/usr/local/emhttp/plugins/folder.view2') || is_dir('/usr/local/emhttp/plugins/folder.view');
    $auroraDockerView = ($aurora['dockerview'] ?? 'folderview') === 'aurora' ? 'aurora' : 'folderview';
?>
<?php if ($auroraFolderView): ?>
<script>window.auroraDockerView = { folderView: true, mode: <?= json_encode($auroraDockerView) ?> };</script>
<?php if ($auroraDockerView === 'aurora'): ?>
<script>
(function () {
  document.documentElement.classList.add('tp-aurora-view', 'fv3-docker-ready', 'fv3-vm-ready');
  // On the Dashboard FolderView builds its folders from a jQuery prefilter on the tile's data
  // request (DashboardApps.php); that one prefilter is not registered.
  if (window.jQuery && typeof jQuery.ajaxPrefilter === 'function') {
    var addPrefilter = jQuery.ajaxPrefilter;
    jQuery.ajaxPrefilter = function (types, handler) {
      var fn = typeof types === 'function' ? types : handler;
      if (typeof fn === 'function' && /createFolders/.test(String(fn))) return;
      return addPrefilter.apply(this, arguments);
    };
  }
  ['listview', 'loadlist'].forEach(function (name) {
    var original;
    Object.defineProperty(window, name + '_original', {
      configurable: true,
      get: function () { return original; },
      set: function (value) {
        original = value;
        queueMicrotask(function () { window[name] = value; });
      }
    });
  });
})();
</script>
<?php endif; ?>
<?php endif; ?>
<?php endif; ?>
<?php endif; ?>
<?php if ($auroraClasses): ?>
<script>document.documentElement.classList.add(...<?= json_encode($auroraClasses) ?>);</script>
<?php endif; ?>
<?php if (is_file("$auroraCustomDir/custom.css")): ?>
<style id="aurora-custom-css">
<?= str_ireplace('</style', '<\/style', file_get_contents("$auroraCustomDir/custom.css")) ?>

</style>
<?php endif; ?>
<?php if (is_file("$auroraCustomDir/custom.js")): ?>
<script id="aurora-custom-js">
document.addEventListener('DOMContentLoaded', function () {
<?= str_ireplace('</script', '<\/script', file_get_contents("$auroraCustomDir/custom.js")) ?>

});
</script>
<?php endif; ?>
<?php endif; ?>
