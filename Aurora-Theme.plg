<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN name="Aurora-Theme"
        author="Tunefish"
        version="2026.10.26.0033"
        launch="Settings/AuroraThemeSettings"
        pluginURL="https://raw.githubusercontent.com/Tunefish92/Aurora-Theme/release/Aurora-Theme.plg"
        support="https://github.com/Tunefish92/Aurora-Theme/issues"
        icon="paint-brush"
        min="7.2.0">

<CHANGES>
###2026.10.26.0033
- New colours, fonts, tables, buttons, dialogs and notification panel for the Black and White themes.
- Optional sidebar navigation layout.
- Page enhancements: brand and server card in the sidebar, slim top bar, page headings, status pills, Docker summary and filters.
- Own Stats page with a built-in collector, replacing Dynamix System Statistics.
- Docker application groups, compact container list, restyled switches and menus.
- Updates from the GitHub releases: "Check for updates" and "Update now" on the settings page, and automatic updates (on by default, weekly).
- Redesigned Main, Users, VMs and login page; live port check in the Docker editor; dark / light switch.
- Redesigned top bar, Apps tab, tool pages, help boxes and notices; the processor tile shows its cores as a compact grid.
- Phone layout fixes across the webGUI: Dashboard tiles, wide tables, VM editor, Apps, header and pop-ups.
- Plugins page: a plugin whose update check failed for a moment ("not available") is checked again; Aurora's own check needs a single request.
- Choose when automatic updates run (hourly, daily or weekly at a set time); redesigned GPU Statistics tile.
- GPU tile: an idle GPU's clock reads "idle"; NVIDIA and AMD rows tidied.
- Docker page loads much faster with many containers, with a loading status; array usage widget; custom banner and header colours shown; Display Settings fixes.
- FolderView support with an Aurora / FolderViewPlugin switch; groups on the Dashboard with app icons and CPU / RAM sums; VM usage cards, accent colour, phone fixes.
- Containers keep Unraid's order and start in the order they are listed: drag them within and between groups, and move whole groups while the list is unlocked. VM groups on the VMs tab and the Dashboard, a buttons column on the VMs tab, group icons that open the app's menu and show stopped apps too. The sidebar can be hidden. FolderView3: the view switch on the VMs tab as well, drag to the top of the list, its autostart sequence respected, a tidier settings page. Fixes for long names on phones, the updates count and the server card.
- Top layout: with the array usage indicator on, Stats and Tools are back in the menu; the indicator sits in the top bar on wide screens.
- New "Fonts" setting: Aurora's Inter and Space Grotesk, or Unraid's own Clear Sans.
- Dark / light switch: only the theme setting in dynamix.cfg is changed, and settings lost while the Unraid API rewrites the file are put back (two quick switches could empty it).
- With "Favorites enabled" set to No in Display Settings, Unraid's Favorites tab is hidden too.
- Docker start delay ("wait") field wide enough for its number in FolderView3's view.
- An orange dot on a container's icon when an update is ready, running or not: on the Dashboard, in group and folder icons and in the Docker tab's compact list. A stopped container with an update stays on the Dashboard when stopped containers are hidden.
- FolderView Plus support: with it installed, its folders arrange the Docker and VMs tabs and the Dashboard, and Aurora keeps to colours and layout (no view switch).
- After an update, the next page shows "Aurora Theme updated" with the new version and its release notes; automatic updates also show an Unraid notification. Automatic updates are checked weekly by default.
- Docker and VMs tabs with FolderView3 or FolderView Plus: a "beta" note in the top bar; their support still has compatibility issues and is being worked on. With both installed, a warning that this is not supported (also on the Dashboard and the Plugins page).
- Faster on busy pages: style rules that the browser checked again on every change of any page (Community Applications cards, GPU tile) are limited to their page or replaced.
</CHANGES>

<!-- Install: write all plugin files. Generated by plugin/build.py; edit the sources, not this file. -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
rm -rf /usr/local/emhttp/plugins/Aurora-Theme
mkdir -p /usr/local/emhttp/plugins/Aurora-Theme/styles /usr/local/emhttp/plugins/Aurora-Theme/scripts /usr/local/emhttp/plugins/Aurora-Theme/include /usr/local/emhttp/plugins/Aurora-Theme/fonts /boot/config/plugins/Aurora-Theme
OLD=Tunefish-Future-Theme
if [ -e /boot/config/plugins/$OLD.plg ] || [ -d /usr/local/emhttp/plugins/$OLD ]; then
  for f in $OLD.cfg docker-groups.json favourites.json custom.css custom.js; do
    src=/boot/config/plugins/$OLD/$f
    dst=/boot/config/plugins/Aurora-Theme/${f/$OLD/Aurora-Theme}
    if [ -f "$src" ] && [ ! -f "$dst" ]; then cp "$src" "$dst"; fi
  done
  if [ -d /var/lib/tunefish-future-theme ] && [ ! -d /var/lib/aurora-theme ]; then
    mv /var/lib/tunefish-future-theme /var/lib/aurora-theme
  fi
  rm -rf /usr/local/emhttp/plugins/$OLD /boot/config/plugins/$OLD /var/lib/tunefish-future-theme
  rm -f /boot/config/plugins/$OLD.plg /var/log/plugins/$OLD.plg
  echo "Settings moved over from $OLD, which has been removed."
fi
old=$(sed -n 's/^[[:space:]]*version="\([^"]*\)".*/\1/p' /boot/config/plugins/Aurora-Theme.plg 2>/dev/null | head -n 1)
if [[ "$old" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}[A-Za-z0-9._-]*$ && "$old" != "2026.10.26.0033" ]]; then
  from=$(sed -n 's/.*"from":"\([^"]*\)".*/\1/p' /boot/config/plugins/Aurora-Theme/updated.json 2>/dev/null)
  [[ "$from" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}[A-Za-z0-9._-]*$ ]] || from=$old
  printf '{"from":"%s","to":"%s","time":%s}\n' "$from" "2026.10.26.0033" "$(date +%s)" > /boot/config/plugins/Aurora-Theme/updated.json
fi
cat > /usr/local/emhttp/plugins/Aurora-Theme/AuroraTheme.page <<'AURORA_THEME_EOF'
Menu="Buttons"
Link="nav-user"
Title="Aurora Theme"
---
<?php
// Unraid evaluates every "Buttons" page inside <head> on each page, after its own stylesheets,
// so this is where the theme's files are attached. Link="nav-user" keeps it from adding a button.
$aurora = parse_plugin_cfg('Aurora-Theme');
$auroraCustomDir = '/boot/config/plugins/Aurora-Theme';
$auroraClasses = [];
if (($aurora['layout'] ?? 'top') == 'sidebar') $auroraClasses[] = 'tp-sidebar';
if (($aurora['enhance'] ?? 'yes') == 'yes') $auroraClasses[] = 'tp-enhance';
// Display Settings, "Favorites enabled" set to No also turns off the theme's starred cards.
if (($display['favorites'] ?? 'yes') == 'no') $auroraClasses[] = 'tp-no-favourites';
// The page, from the first part of the address ("/Apps/..." gives tp-on-apps), so rules that
// only matter on one page can be limited to it; the browser then skips them everywhere else.
$auroraPage = strtolower(preg_replace('/[^A-Za-z0-9-]/', '', explode('/', trim((string) parse_url($_SERVER['REQUEST_URI'] ?? '', PHP_URL_PATH), '/'))[0]));
if ($auroraPage !== '') $auroraClasses[] = 'tp-on-' . $auroraPage;

// Emergency switch: opening any page with ?aurora=off stops the plugin from loading anything
// in this browser (remembered in a cookie) until a page is opened with ?aurora=on.
$auroraSwitch = $_GET['aurora'] ?? '';
$auroraOff = $auroraSwitch == 'off' || ($auroraSwitch != 'on' && !empty($_COOKIE['aurora_off']));
// The theme is made for Unraid's top-navigation themes (Black, White). Azure and Gray have
// their own sidebar layout, so there the plugin loads nothing and leaves them as they are.
if (isset($themeHelper) && method_exists($themeHelper, 'isTopNavTheme') && !$themeHelper->isTopNavTheme()) $auroraOff = true;
?>
<?php if ($auroraSwitch == 'off'): ?>
<script>document.cookie = 'aurora_off=1; path=/; max-age=31536000; SameSite=Lax';</script>
<?php elseif ($auroraSwitch == 'on'): ?>
<script>document.cookie = 'aurora_off=; path=/; max-age=0; SameSite=Lax';</script>
<?php endif; ?>
<?php if (!$auroraOff): ?>
<?php if (($aurora['theme'] ?? 'yes') == 'yes'): ?>
<link type="text/css" rel="stylesheet" href="<?php autov('/plugins/Aurora-Theme/styles/theme.css') ?>">
<?php
// Display Settings, header custom text, secondary text and background colours: the theme sets
// Unraid's header variables itself, so the chosen colours are handed to it under its own names.
$auroraHeaderVars = [];
foreach (['header' => '--tp-custom-header-text', 'headermetacolor' => '--tp-custom-header-muted', 'background' => '--tp-custom-header-bg'] as $auroraKey => $auroraVar) {
    $auroraHex = (string) ($display[$auroraKey] ?? '');
    if (preg_match('/^([0-9a-fA-F]{3}){1,2}$/', $auroraHex)) $auroraHeaderVars[] = "$auroraVar: #$auroraHex;";
}
?>
<?php if ($auroraHeaderVars): ?>
<style id="aurora-header-colors">:root { <?= implode(' ', $auroraHeaderVars) ?> }</style>
<?php endif; ?>
<?php
// Accent colour from the plugin's settings ("#e11d48"; empty keeps the theme's blue). The
// theme's shades are mixed from it, and the text on accent buttons is white or near-black,
// whichever stands out more.
$auroraAccent = strtolower(ltrim(trim((string) ($aurora['accent'] ?? '')), '#'));
if (preg_match('/^[0-9a-f]{3}$/', $auroraAccent)) $auroraAccent = preg_replace('/(.)/', '$1$1', $auroraAccent);
if (preg_match('/^[0-9a-f]{6}$/', $auroraAccent)):
    $auroraLum = function ($hex) {
        $l = [];
        foreach (str_split($hex, 2) as $c) { $v = hexdec($c) / 255; $l[] = $v <= 0.03928 ? $v / 12.92 : (($v + 0.055) / 1.055) ** 2.4; }
        return 0.2126 * $l[0] + 0.7152 * $l[1] + 0.0722 * $l[2];
    };
    $auroraL = $auroraLum($auroraAccent);
    $auroraOnAccent = (1.05 / ($auroraL + 0.05)) >= (($auroraL + 0.05) / ($auroraLum('06101f') + 0.05)) ? '#ffffff' : '#06101f';
    $auroraHex = "#$auroraAccent";
    $auroraScale = [];
    foreach ([50 => 'white 92%', 100 => 'white 84%', 200 => 'white 68%', 300 => 'white 48%', 400 => 'white 24%', 500 => 'white 6%', 600 => 'black 8%', 700 => 'black 24%', 800 => 'black 40%', 900 => 'black 54%', 950 => 'black 70%'] as $auroraStep => $auroraMix) {
        $auroraScale[] = "--color-primary-$auroraStep: color-mix(in oklab, $auroraHex, $auroraMix); --ui-color-primary-$auroraStep: color-mix(in oklab, $auroraHex, $auroraMix);";
    }
?>
<style id="aurora-accent">
:root:root:root { --tp-primary: <?= $auroraHex ?>; --tp-primary-ii: color-mix(in oklab, <?= $auroraHex ?> 62%, white); --tp-primary-soft: color-mix(in srgb, <?= $auroraHex ?> 15%, transparent); --tp-primary-text: <?= $auroraOnAccent ?>; }
.unapi:not(#tp-none):not(#tp-none) { <?= implode(' ', $auroraScale) ?> }
</style>
<?php endif; ?>
<?php if (($aurora['font'] ?? 'aurora') === 'unraid'): ?>
<?php
// Fonts from the plugin's settings, "Unraid default": theme.css points Unraid's font names
// (clear-sans, bitstream) at Inter; these later rules point them back at Unraid's own files, and
// the theme's text and headings use Clear Sans.
$auroraFonts = [];
foreach (['clear-sans', 'bitstream'] as $auroraFamily) {
    foreach (['normal' => '', 'bold' => '-bold'] as $auroraWeight => $auroraWeightFile) {
        foreach (['normal' => '', 'italic' => '-italic'] as $auroraStyle => $auroraStyleFile) {
            $auroraFonts[] = "@font-face { font-family: $auroraFamily; font-weight: $auroraWeight; font-style: $auroraStyle; src: url('/webGui/styles/$auroraFamily$auroraWeightFile$auroraStyleFile.woff') format('woff'); }";
        }
    }
}
?>
<style id="aurora-fonts">
<?= implode("\n", $auroraFonts) ?>

:root:root:root { --tp-font-body: clear-sans, system-ui, -apple-system, "Segoe UI", sans-serif; --tp-font-heading: var(--tp-font-body); }
</style>
<?php endif; ?>
<script>
// Theme credit at the end of the footer.
document.addEventListener('DOMContentLoaded', function () {
  var footer = document.getElementById('copyright');
  if (!footer || footer.querySelector('.tp-credit')) return;
  var link = document.createElement('a');
  link.className = 'tp-credit';
  link.href = 'https://github.com/Tunefish92';
  link.target = '_blank';
  link.rel = 'noopener noreferrer';
  link.title = 'Aurora Theme on GitHub';
  link.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/></svg>Aurora Theme by <strong>Tunefish</strong>';
  footer.append(link);
});
</script>
<?php endif; ?>
<script>
// "tp-topbar" while the menu is a bar across the top: always in the top layout, and in the
// sidebar layout on screens narrower than 1024px. Set here in the head, so there is no flash.
(function (root, sidebar) {
  var wide = window.matchMedia('(min-width: 1024px)');
  var set = function () { root.classList.toggle('tp-topbar', !(sidebar && wide.matches)); };
  set();
  wide.addEventListener('change', set);
})(document.documentElement, <?= in_array('tp-sidebar', $auroraClasses) ? 'true' : 'false' ?>);
</script>
<?php if (in_array('tp-sidebar', $auroraClasses)): ?>
<link type="text/css" rel="stylesheet" href="<?php autov('/plugins/Aurora-Theme/styles/layout-sidebar.css') ?>">
<script>
// Sidebar layout: a button at the left of the top bar hides the sidebar completely or brings it
// back. This browser remembers the choice; it is applied here in the head, so there is no flash.
(function (root) {
  var key = 'tft-sidebar-collapsed';
  try { if (localStorage.getItem(key) === '1') root.classList.add('tp-sidebar-collapsed'); } catch (e) {}
  document.addEventListener('DOMContentLoaded', function () {
    var header = document.getElementById('header');
    if (!header || header.querySelector('.tp-sidebar-toggle')) return;
    var button = document.createElement('button');
    button.type = 'button';
    button.className = 'tp-sidebar-toggle';
    button.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M9 4v16"/></svg>';
    var label = function () {
      var collapsed = root.classList.contains('tp-sidebar-collapsed');
      button.title = collapsed ? 'Show sidebar' : 'Hide sidebar';
      button.setAttribute('aria-label', button.title);
      button.setAttribute('aria-expanded', String(!collapsed));
    };
    button.addEventListener('click', function () {
      root.classList.add('tp-sidebar-animate');
      var collapsed = root.classList.toggle('tp-sidebar-collapsed');
      try { localStorage.setItem(key, collapsed ? '1' : '0'); } catch (e) {}
      label();
    });
    label();
    header.prepend(button);
  });
})(document.documentElement);
</script>
<?php endif; ?>
<?php if (in_array('tp-enhance', $auroraClasses)): ?>
<?php
// The page's own title ("CPU Pinning", "UPS Settings") for the heading and breadcrumb, made the
// way Unraid makes its section titles. Without it the script names the page from its address.
$auroraTitle = '';
try {
    $auroraTitle = (string) ($myPage['Title'] ?? '');
    if ($auroraTitle !== '' && function_exists('processTitle')) $auroraTitle = processTitle($auroraTitle);
    if ($auroraTitle !== '' && function_exists('parse_text')) $auroraTitle = _(parse_text(html_entity_decode($auroraTitle)));
    $auroraTitle = trim(preg_replace('/\s+/', ' ', strip_tags($auroraTitle)));
    if (strpos($auroraTitle, '$') !== false || mb_strlen($auroraTitle) > 60) $auroraTitle = '';
} catch (Throwable $auroraError) {
    $auroraTitle = '';
}
?>
<?php if ($auroraTitle !== ''): ?>
<script>window.auroraPageTitle = <?= json_encode($auroraTitle, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;</script>
<?php endif; ?>
<link type="text/css" rel="stylesheet" href="<?php autov('/plugins/Aurora-Theme/styles/enhance.css') ?>">
<script defer src="<?php autov('/plugins/Aurora-Theme/scripts/enhance.js') ?>"></script>
<?php
// Plugins page: FolderView Plus beside FolderView3 or FolderView2 is not supported. The warning
// of the Docker and VMs tabs (folderViewBeta() in enhance.js) shows here too, where it is fixed.
if (rtrim((string) parse_url($_SERVER['REQUEST_URI'] ?? '', PHP_URL_PATH), '/') === '/Plugins' && is_dir('/usr/local/emhttp/plugins/folderview.plus')
    && (is_dir('/usr/local/emhttp/plugins/folder.view3') || is_dir('/usr/local/emhttp/plugins/folder.view2'))):
?>
<script>window.auroraFolderViewConflict = <?= json_encode(is_dir('/usr/local/emhttp/plugins/folder.view3') ? 'FolderView3' : 'FolderView2') ?>;</script>
<?php endif; ?>
<?php
// Docker and VMs tabs and Dashboard: the saved groups go straight into the page, so the
// containers and VMs can be shown grouped right away instead of waiting for a separate request.
if (in_array(rtrim((string) parse_url($_SERVER['REQUEST_URI'] ?? '', PHP_URL_PATH), '/'), ['/Docker', '/VMs', '/Dashboard'], true)):
    $auroraGroups = [];
    foreach (['docker', 'vm'] as $auroraKind) {
        $auroraStored = json_decode((string) @file_get_contents("$auroraCustomDir/$auroraKind-groups.json"), true);
        $auroraGroups[$auroraKind] = is_array($auroraStored['groups'] ?? null) ? $auroraStored['groups'] : [];
    }
?>
<script>window.auroraDockerGroups = <?= json_encode($auroraGroups['docker'], JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;</script>
<script>window.auroraVmGroups = <?= json_encode($auroraGroups['vm'], JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;</script>
<script>window.auroraDecimalMark = <?= json_encode(substr((string) ($display['number'] ?? '.,'), 0, 1) ?: '.') ?>;</script>
<?php
    // FolderView installed: the switch above the Docker list chooses between its folders and the
    // theme's view (columns, groups). For the theme's view, FolderView's takeover of Unraid's
    // listview() and loadlist() is undone: it keeps the originals as listview_original and
    // loadlist_original, and as soon as it does, they are put back (after its script has run,
    // before Unraid draws the list). FolderView's own "hide the list until the folders are
    // built" is lifted at once.
    // FolderView Plus (folderview.plus, issue #23) asks themes to leave its lists to it, without
    // replacing listview / loadlist: with it there is no switch, its folders always draw the
    // Docker and VMs tabs and the Dashboard, and the theme keeps to colours and layout
    // (tp-fvplus). See its docs/THEME_API_CONTRACT.md, "Layout Ownership for Theme Integrations".
    // Plus does not run beside FolderView3 or FolderView2 (it shows a conflict notice instead),
    // so then the older plugin draws the lists and is treated as such.
    $auroraFolderViewPlus = is_dir('/usr/local/emhttp/plugins/folderview.plus') && !is_dir('/usr/local/emhttp/plugins/folder.view3') && !is_dir('/usr/local/emhttp/plugins/folder.view2');
    $auroraFolderView = $auroraFolderViewPlus || is_dir('/usr/local/emhttp/plugins/folder.view3') || is_dir('/usr/local/emhttp/plugins/folder.view2') || is_dir('/usr/local/emhttp/plugins/folder.view');
    $auroraDockerView = !$auroraFolderViewPlus && ($aurora['dockerview'] ?? 'folderview') === 'aurora' ? 'aurora' : 'folderview';
    if ($auroraFolderViewPlus) $auroraClasses[] = 'tp-fvplus';
    // The plugin that draws the folders, by name, for the beta notice on the Docker and VMs tabs.
    $auroraFolderViewName = $auroraFolderViewPlus ? 'FolderView Plus' : (is_dir('/usr/local/emhttp/plugins/folder.view3') ? 'FolderView3' : (is_dir('/usr/local/emhttp/plugins/folder.view2') ? 'FolderView2' : 'FolderView'));
    // FolderView Plus beside FolderView3 or FolderView2 is not supported (Plus pauses its folders,
    // "safe mode", and asks to remove the other one): a warning instead of the beta notice.
    $auroraFolderViewBoth = is_dir('/usr/local/emhttp/plugins/folderview.plus') && !$auroraFolderViewPlus;
?>
<?php if ($auroraFolderView): ?>
<script>window.auroraDockerView = { folderView: true, plus: <?= $auroraFolderViewPlus ? 'true' : 'false' ?>, mode: <?= json_encode($auroraDockerView) ?>, name: <?= json_encode($auroraFolderViewName) ?>, both: <?= $auroraFolderViewBoth ? 'true' : 'false' ?> };</script>
<?php if ($auroraDockerView === 'aurora'): ?>
<script>
(function () {
  document.documentElement.classList.add('tp-aurora-view', 'fv3-docker-ready', 'fv3-vm-ready');
  // On the Dashboard FolderView builds its folders from a jQuery prefilter on the tile's data
  // request (DashboardApps.php); that one prefilter is not registered. Nor is the one on the
  // list order Unraid saves (UserPrefs.php): it renumbers the folders' places and copies the
  // order into FolderView3's own snapshot (update_order.php), which FolderView3 later uses to
  // put its folders back in place. Saved from this view, without folders, the snapshot lost
  // them, and after switching back every folder stood at the top of the list.
  if (window.jQuery && typeof jQuery.ajaxPrefilter === 'function') {
    var addPrefilter = jQuery.ajaxPrefilter;
    jQuery.ajaxPrefilter = function (types, handler) {
      var fn = typeof types === 'function' ? types : handler;
      if (typeof fn === 'function' && /createFolders|update_order\.php/.test(String(fn))) return;
      return addPrefilter.apply(this, arguments);
    };
  }
  // FolderView3 rewrites the containers' start order after every change of the list order or of
  // an autostart setting (sync_order.php): from its own folders, or from the custom sequence on
  // its Autostart tab. In the theme's view the list as shown (groups and all) is the start order,
  // so the folder-based rewrite is left out; a custom sequence is still applied, the same way.
  if (window.jQuery && jQuery.fn && typeof jQuery.fn.ajaxComplete === 'function') {
    var addComplete = jQuery.fn.ajaxComplete;
    jQuery.fn.ajaxComplete = function (handler) {
      if (typeof handler === 'function' && /sync_order\.php/.test(String(handler))) return this;
      return addComplete.apply(this, arguments);
    };
    jQuery(document).on('ajaxComplete', function (event, xhr, settings) {
      var url = (settings && settings.url) || '';
      var data = settings && typeof settings.data === 'string' ? settings.data : '';
      var orderSaved = url.indexOf('/dynamix.docker.manager/include/UserPrefs.php') !== -1 && data.indexOf('names=') !== -1;
      var autostartSaved = url.indexOf('/dynamix.docker.manager/include/UpdateConfig.php') !== -1 && /action=(autostart|wait)/.test(data);
      if (!(orderSaved || autostartSaved) || xhr.status !== 200) return;
      jQuery.getJSON('/plugins/folder.view3/server/read_autostart.php').done(function (config) {
        if (config && config.mode === 'custom') jQuery.post('/plugins/folder.view3/server/sync_order.php', { type: 'docker' });
      });
    });
  }
  ['listview', 'loadlist'].forEach(function (name) {
    var original;
    Object.defineProperty(window, name + '_original', {
      configurable: true,
      get: function () { return original; },
      set: function (value) {
        original = value;
        queueMicrotask(function () { window[name] = value; });
      }
    });
  });
})();
</script>
<?php endif; ?>
<?php endif; ?>
<?php endif; ?>
<?php endif; ?>
<?php if ($auroraClasses): ?>
<script>document.documentElement.classList.add(...<?= json_encode($auroraClasses) ?>);</script>
<?php endif; ?>
<?php if (in_array('tp-no-favourites', $auroraClasses)): ?>
<?php // Unraid shows its Favorites tab whenever /boot/config/favorites.cfg holds pages, even
      // with favourites switched off (issue #25); the theme hides it then. ?>
<style>#menu .nav-item:has(> a[href="/Favorites"]) { display: none !important; }</style>
<?php endif; ?>
<?php if (is_file("$auroraCustomDir/updated.json")): ?>
<?php // After an update (the install script leaves updated.json): the "Aurora Theme updated"
      // dialog, once. Nothing is loaded for it otherwise. ?>
<link type="text/css" rel="stylesheet" href="<?php autov('/plugins/Aurora-Theme/styles/updated.css') ?>">
<script defer src="<?php autov('/plugins/Aurora-Theme/scripts/updated.js') ?>"></script>
<?php endif; ?>
<?php if (is_file("$auroraCustomDir/custom.css")): ?>
<style id="aurora-custom-css">
<?= str_ireplace('</style', '<\/style', file_get_contents("$auroraCustomDir/custom.css")) ?>

</style>
<?php endif; ?>
<?php if (is_file("$auroraCustomDir/custom.js")): ?>
<script id="aurora-custom-js">
document.addEventListener('DOMContentLoaded', function () {
<?= str_ireplace('</script', '<\/script', file_get_contents("$auroraCustomDir/custom.js")) ?>

});
</script>
