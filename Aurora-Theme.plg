<?php
// "Update": the plugin is updated from its GitHub releases (include/UpdateLib.php).
require_once '/usr/local/emhttp/plugins/Aurora-Theme/include/UpdateLib.php';
$auroraInstalled = aurora_installed_version();
// Outcome of the last automatic check (scripts/autoupdate.php); kept in RAM, so empty after a reboot.
$auroraAuto = json_decode((string) @file_get_contents('/var/lib/aurora-theme/autoupdate.json'), true) ?: [];
// The record names the version installed at that check. Once another version has been installed
// ("Update now", the Plugins page), its outcome ("Up to date (old version)") no longer applies.
if (!empty($auroraAuto['version']) && (string) $auroraAuto['version'] !== $auroraInstalled) $auroraAuto = [];
$auroraAutoOn = ($aurora['autoupdate'] ?? 'yes') === 'yes';
$auroraAutoNewer = ($auroraAuto['result'] ?? '') !== 'updated' && !empty($auroraAuto['version']) && strcmp((string) $auroraAuto['version'], $auroraInstalled) > 0;
$auroraRepo = 'Tunefish92/Aurora-Theme';
?>
<link type="text/css" rel="stylesheet" href="<?php autov('/plugins/Aurora-Theme/styles/settings.css') ?>">
