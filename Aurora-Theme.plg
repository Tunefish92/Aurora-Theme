<script>
// "Check for updates": asks the server for the newest GitHub release and shows the answer in
// the card; the update button appears when there is something newer.
function auroraCheck(button) {
  if (button.disabled) return;
  var label = button.innerHTML;
  var card = document.querySelector('.tft-update-card');
  var title = document.getElementById('tft-update-title');
  var message = document.getElementById('tft-update-message');
  var icon = document.getElementById('tft-update-icon');
  var update = document.getElementById('tft-update-button');
  var note = document.getElementById('tft-update-note');
  var show = function (state, iconName, heading, text) {
    card.className = 'tft-update-card tft-state-' + state;
    icon.className = 'fa ' + iconName;
    title.textContent = heading;
    message.textContent = text;
  };
  button.disabled = true;
  button.innerHTML = '<i class="fa fa-refresh fa-spin"></i> Checking…';
  note.textContent = '';
  fetch('/plugins/Aurora-Theme/include/check-update.php', { method: 'POST', credentials: 'same-origin', body: new URLSearchParams({ csrf_token: window.csrf_token || '' }) })
    .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
    .then(function (result) {
      var data = result.data || {};
      if (!result.ok) throw new Error(data.error || 'The check did not work.');
      if (data.newer) {
        show('available', 'fa-arrow-circle-down', 'Update available', data.message);
        update.hidden = false;
        update.innerHTML = '<i class="fa fa-download"></i> Update to ' + data.available;
        update.dataset.plg = data.plg || '';
      } else {
        show('current', 'fa-check-circle', 'Up to date', data.message);
        update.hidden = true;
      }
    })
    .catch(function (error) {
      show('missing', 'fa-question-circle', 'Check failed', error.message);
    })
    .finally(function () {
      button.disabled = false;
      button.innerHTML = label;
    });
}

function auroraUpdate(button) {
  // Installs the exact release the check found (its own download address; the "latest" address
  // can still point to the previous release for a minute after a new one is published). Without
  // a check on this page yet, it checks first. Progress shows in Unraid's install dialog.
  // Unraid gives up silently when the plugin manager cannot start the task right now (for
  // example while the automatic update runs), so the button says what is happening.
  if (button) {
    if (button.disabled) return;
    button.disabled = true;
    button.dataset.label = button.innerHTML;
    button.innerHTML = '<i class="fa fa-refresh fa-spin"></i> Starting…';
  }
  var latest = <?= json_encode(AURORA_RELEASE_PLG) ?>;
  if (button && button.dataset.plg) {
    auroraInstall(button, button.dataset.plg);
    return;
  }
  fetch('/plugins/Aurora-Theme/include/check-update.php', { method: 'POST', credentials: 'same-origin', body: new URLSearchParams({ csrf_token: window.csrf_token || '' }) })
    .then(function (response) { return response.json(); })
    .then(function (data) { auroraInstall(button, data.plg || latest); })
    .catch(function () { auroraInstall(button, latest); });
}

function auroraInstall(button, plg) {
  openPlugin('plugin install ' + plg, 'Update Aurora Theme', '', 'refresh');
  if (!button) return;
  var waited = 0;
  var watch = setInterval(function () {
    waited += 250;
    var dialog = document.querySelector('.sweet-alert.nchan, .sweet-alert.showSweetAlert');
    if (dialog && dialog.offsetParent !== null) {
      clearInterval(watch);
      button.disabled = false;
      button.innerHTML = button.dataset.label;
    } else if (waited >= 6000) {
      clearInterval(watch);
      button.disabled = false;
      button.innerHTML = button.dataset.label;
      var note = document.getElementById('tft-update-note');
      if (note) note.textContent = 'The update could not start right now; the plugin manager may still be busy (for example with the automatic update). Please try again in a moment.';
    }
  }, 250);
}
</script>

<div class="title"><span class="left"><i class="fa fa-github title"></i>_(Feedback and issues)_</span></div>
<div class="tft-issue">
<p class="tft-issue-intro">Report a bug, something that is not implemented yet, or an idea. This opens a new issue on GitHub with your text filled in; you review and submit it there. Nothing is sent from this server.</p>
<div class="tft-segment" role="radiogroup" aria-label="Kind of report">
<button type="button" class="tft-segment-option" role="radio" aria-checked="true" data-kind="Bug">Bug</button><button type="button" class="tft-segment-option" role="radio" aria-checked="false" data-kind="Missing">Not implemented yet</button><button type="button" class="tft-segment-option" role="radio" aria-checked="false" data-kind="Feature">Feature idea</button><button type="button" class="tft-segment-option" role="radio" aria-checked="false" data-kind="Design">Design</button>
</div>
<label class="tft-field"><span>Summary</span><input type="text" id="tft-issue-title" maxlength="120" placeholder="For example: Docker groups do not save"></label>
<label class="tft-field"><span>Details</span><textarea id="tft-issue-body" rows="6" placeholder="What happened, or what would you like? Which page? Steps to reproduce help a lot."></textarea></label>
<label class="tft-check"><input type="checkbox" id="tft-issue-env" checked> Add system details: plugin <?= htmlspecialchars($auroraInstalled ?: 'unknown') ?>, Unraid <?= htmlspecialchars((string) ($var['version'] ?? 'unknown')) ?>, theme <?= htmlspecialchars((string) ($display['theme'] ?? 'unknown')) ?>, layout <?= htmlspecialchars((string) ($aurora['layout'] ?? '')) ?>, browser</label>
<div class="tft-issue-actions"><button type="button" class="tft-button tft-button-primary" id="tft-issue-open" disabled><i class="fa fa-github"></i> Open issue on GitHub</button><a class="tft-link" href="https://github.com/<?= htmlspecialchars($auroraRepo) ?>/issues" target="_blank" rel="noopener noreferrer">See existing issues</a></div>
</div>
<script>
(function () {
  var repo = <?= json_encode($auroraRepo) ?>;
  var details = <?= json_encode([
      'Plugin' => $auroraInstalled ?: 'unknown',
      'Unraid' => (string) ($var['version'] ?? 'unknown'),
      'Dynamix theme' => (string) ($display['theme'] ?? 'unknown'),
      'Layout' => (string) ($aurora['layout'] ?? ''),
      'Enhancements' => (string) ($aurora['enhance'] ?? ''),
      'Stats page' => (string) ($aurora['stats'] ?? ''),
  ]) ?>;
  var kinds = { Bug: 'Bug', Missing: 'Not implemented', Feature: 'Feature', Design: 'Design' };
  // GitHub's standard labels; GitHub applies them only for people allowed to label issues.
  var labels = { Bug: 'bug', Missing: 'enhancement', Feature: 'enhancement', Design: 'enhancement' };
  var kind = 'Bug';
  var title = document.getElementById('tft-issue-title');
  var body = document.getElementById('tft-issue-body');
  var open = document.getElementById('tft-issue-open');
  var options = document.querySelectorAll('.tft-segment-option');
  options.forEach(function (option) {
    option.addEventListener('click', function () {
      kind = option.dataset.kind;
      options.forEach(function (other) { other.setAttribute('aria-checked', String(other === option)); });
    });
  });
  // The browser as a name and major version ("Brave 141", "Firefox 157"), not the whole
  // user-agent string, which every Chromium browser fills with "Chrome" and "Safari". Chromium
  // browsers name themselves in userAgentData; Brave also marks itself with navigator.brave.
  function browserName() {
    var ua = navigator.userAgent;
    var data = navigator.userAgentData;
    var brand = data && Array.isArray(data.brands) && data.brands.filter(function (entry) {
      return !/chromium|not.?a.?brand/i.test(entry.brand);
    })[0];
    if (navigator.brave) {
      var chromium = data && Array.isArray(data.brands) && data.brands.filter(function (entry) { return /chromium/i.test(entry.brand); })[0];
      var match = ua.match(/Chrome\/(\d+)/);
      return 'Brave ' + (chromium ? chromium.version : match ? match[1] : '');
    }
    if (brand) return brand.brand.replace(/^(?:Google|Microsoft) /, '') + ' ' + brand.version;
    var known = [['Edge', /Edg(?:e|A|iOS)?\/(\d+)/], ['Opera', /OPR\/(\d+)/], ['Vivaldi', /Vivaldi\/(\d+)/],
      ['Samsung Internet', /SamsungBrowser\/(\d+)/], ['Firefox', /(?:Firefox|FxiOS)\/(\d+)/],
      ['Chrome', /(?:Chrome|CriOS)\/(\d+)/], ['Safari', /Version\/(\d+).*Safari/]];
    for (var i = 0; i < known.length; i++) {
      var found = ua.match(known[i][1]);
      if (found) return known[i][0] + ' ' + found[1];
    }
    return 'unknown';
  }
  title.addEventListener('input', function () { open.disabled = !title.value.trim(); });
  open.addEventListener('click', function () {
    var text = body.value.trim() || '_No details given._';
    if (document.getElementById('tft-issue-env').checked) {
      text += '\n\n---\n**System**\n' + Object.keys(details).map(function (key) { return '- ' + key + ': ' + details[key]; }).join('\n')
        + '\n- Browser: ' + browserName();
    }
    var url = 'https://github.com/' + repo + '/issues/new?title=' + encodeURIComponent('[' + kinds[kind] + '] ' + title.value.trim())
      + '&body=' + encodeURIComponent(text) + '&labels=' + encodeURIComponent(labels[kind]);
    window.open(url, '_blank', 'noopener');
  });
})();
</script>

